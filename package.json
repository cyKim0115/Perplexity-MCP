{
  "name": "perplexity-session-mcp",
  "version": "0.2.0",
  "description": "Perplexity MCP server that logs in with your own Perplexity account (browser session, no API key): search, deep research, and searchable answer history.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "perplexity",
    "model-context-protocol",
    "claude",
    "codex",
    "deep-research"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyKim0115/Perplexity-MCP.git"
  },
  "homepage": "https://github.com/cyKim0115/Perplexity-MCP#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "pplx": "bin/pplx.js",
    "perplexity-session-mcp": "bin/pplx.js"
  },
  "files": [
    "bin/",
    "dist/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/pplx.js serve",
    "login": "node bin/pplx.js login",
    "status": "node bin/pplx.js status",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "patchright": "^1.63.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "bugs": {
    "url": "https://github.com/cyKim0115/Perplexity-MCP/issues"
  }
}
